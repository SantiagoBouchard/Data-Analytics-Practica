CREATE Table Clientes(
Id_Cliente INT, -- numero entero
nombre varchar(100), --texto de maximo 100 caracteres
perfil_bio TEXT, --texto largo
fecha_registro date --fecha
);

Create Table productos(
Id_Productos INT, --numero entero
descripcion varchar(255), --texto de maximo 255 caracteres
precio decimal(10,2), --numero que admite decimales de maximo 10 digitos con 2 decimales
esta_activo varchar(2) --numero de 2 caracteres
);
